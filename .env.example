# Public frontend configuration. This value contains no credentials.
VITE_AUDIO_CDN_URL=https://audio.example.com

# Server-side import configuration. Never prefix secrets with VITE_.
AUDIO_CDN_URL=https://audio.example.com
AUDIO_STORAGE_UPLOAD_URL=https://storage-upload.example.com/audio
AUDIO_STORAGE_TOKEN=replace-with-server-side-secret
