{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "con-duong-xua-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-14",
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "con-duong-xua-media"
    }
  ],
  "observability": {
    "enabled": true
  }
}
